# Secrets des Edge Functions : Supabase > Edge Functions > Secrets (ou `supabase secrets set`).
# Ne jamais committer le vrai fichier .env.

APP_URL=https://bastienryser.space
# CRON_SECRET est facultatif : par défaut, le secret généré dans le Vault est utilisé.

# App Meta (developers.facebook.com) : Facebook Login for Business
META_APP_ID=
META_APP_SECRET=

# App LinkedIn (linkedin.com/developers) : produits « Sign In with LinkedIn using OpenID Connect » + « Share on LinkedIn »
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Facultatif : app LinkedIn séparée avec la « Community Management API » (page Cantia)
LINKEDIN_PAGE_CLIENT_ID=
LINKEDIN_PAGE_CLIENT_SECRET=

# Client OAuth Google (Search Console et Google Analytics 4) : console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
