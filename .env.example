# Copier ce fichier en .env.local pour le développement, sans jamais le committer.
# En production : Vercel > Project > Settings > Environment Variables.

# Supabase > Project Settings > API (URL) et API Keys (clé « publishable »)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé API Claude (console.anthropic.com), utilisée côté serveur uniquement pour le bouton IA
ANTHROPIC_API_KEY=
